datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = "native"
}

model User {
  id               String              @id // Chess.com id
  username         String?             @unique // platform username
  address          String?             @unique // Torus wallet address
  locale           String?
  email            String?             @unique // Email address
  // --------------- LINKS --------------
  mintPurchases    MintPurchase[]      @relation("mintPurchases")
  rampWithdraws    RampWithdraw[]      @relation("rampWithdraws")
  depositOrders    DepositOrder[]      @relation("depositOrders")
  oAuthConnections OAuthConnection[]   @relation("oAuthConnections")
  // --------------- STATE --------------
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  mfa_enabled      Boolean?
  imageSrc         String? // Avatar URL
  country          String? // Player's country  eg. US, DE
  mintCredits      Int                 @default(3) // Mint for free!
  banned           Boolean             @default(false)
  blocked          Boolean? // Prevents others from interacting with this person
  refreshToken     String? // Discord.com Oauth
  accessToken      String? // Discord.com Oauth
  ramps            Ramp[]
  OAuth            OAuth[]
  promotions       PromotionsOnUsers[]
  betaAccess       Boolean             @default(false)
}

model Ramp {
  id                 String         @id @default(uuid())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User?          @relation(fields: [userId], references: [id])
  userId             String?
  type               RampType
  email              String?
  address            String?
  // Plaid
  accountId          String?
  accountNickname    String?
  mask               String?
  isoCurrencyCode    String?
  itemId             String? // Used to identify an Item in a webhook
  verificationStatus String? // Only used for Auth Item initiated through Automated or Manual micro-deposits
  // Wyre
  paymentMethodId    String? // Wyre
  // Coinbase
  // TODO: Replace with oAuthConnection
  accessToken        String?
  refreshToken       String?
  RampWithdraw       RampWithdraw[]
}

model DepositOrder {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // --------------- LINKS --------------
  user           User     @relation("depositOrders", fields: [userId], references: [id])
  userId         String
  // --------------- STATE --------------
  amount         Float?
  paymentType    RampType
  status         TxStatus @default(UNSUBMITTED)
  // Wyre
  sourceCurrency String?
  sourceAmount   Float?
  purchaseAmount Float?
  destCurrency   String?
  paymentMethod  String?
  orderType      String? // DOMESTIC or INTERNATIONAL
  orderId        String?  @unique // Wyre orderId
  reservation    String?  @unique // Wyre reservation
}

model MintPurchase {
  id                Int                      @id @default(autoincrement())
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  // --------------- LINKS --------------
  user              User                     @relation("mintPurchases", fields: [userId], references: [id])
  userId            String
  // --------------- STATE --------------
  gameId            String
  gameEndTime       String
  title             String // Treasure title
  // Order details
  paymentType       String                   @default("WYRE") // WYRE, MINTCREDIT
  status            RampStatus               @default(PENDING)
  // Wyre or Stripe
  orderStatus       MintPurchaseOrderStatus?
  orderId           String?                  @unique // Wyre orderId
  reservation       String?                  @unique // Wyre reservation
  // Blockchain
  staleTransactions Transaction[]            @relation("staleMintTransactions")
  transaction       Transaction?             @relation(fields: [transactionId], references: [id])
  transactionId     String?                  @unique
}

model OAuth {
  state         String   @id
  codeChallenge String
  codeVerifier  String
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id])
  userId        String?
}

model OAuthConnection {
  id           String              @id @default(uuid())
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation("oAuthConnections", fields: [userId], references: [id])
  userId       String
  type         OAuthConnectionType
  revoked      Boolean             @default(false)
  refreshToken String?
  accessToken  String
  expiration   DateTime?
}

model RampWithdraw {
  id            String      @id @default(uuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  status        RampStatus  @default(PENDING)
  toAddress     String
  amount        Int
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  transactionId String      @unique
  user          User?       @relation("rampWithdraws", fields: [userId], references: [id])
  userId        String?
  ramp          Ramp        @relation(fields: [rampId], references: [id])
  rampId        String
}

model Transaction {
  id                   String        @id
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  // --------------- STATE --------------
  status               TxStatus      @default(SUBMITTED)
  gasLimit             Int           @default(0)
  maxPriorityFeePerGas Int           @default(0)
  maxFeePerGas         Int           @default(0)
  mintPurchase         MintPurchase?
  rampWithdraw         RampWithdraw?
  MintPurchase         MintPurchase? @relation("staleMintTransactions", fields: [mintPurchaseId], references: [id])
  mintPurchaseId       Int?
}

model Promotion {
  id          Int                 @id @default(autoincrement())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  rewardType  PromotionRewardType @default(MINT_CREDIT)
  type        PromotionType
  mintCredits Int? // How many mint credits should be given
  enabled     Boolean             @default(false)
  users       PromotionsOnUsers[]
}

model PromotionsOnUsers {
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  promotionId Int

  @@id([userId, promotionId])
}

enum RampType {
  COINBASE
  WYRE
}

enum OAuthConnectionType {
  TWITCH
  COINBASE
  DISCORD
}

enum RampStatus {
  PENDING
  COMPLETE
  FAILED
}

enum TxStatus {
  UNSUBMITTED
  SUBMITTED
  COMPLETE
  FAILED
}

enum MintPurchaseOrderStatus {
  RESERVATION
  COMPLETE
}

enum PromotionRewardType {
  MINT_CREDIT
}

enum PromotionType {
  TWITCH_CONNECTION
}
