datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = "native"
  previewFeatures = ["clientExtensions"]
}

model User {
  id                    String
  provider              ProviderType
  username              String?
  address               String?               @unique // Torus wallet address
  locale                String?
  email                 String? // Email address
  // --------------- LINKS --------------
  mintPurchases         MintPurchase[]        @relation("mintPurchases")
  rampWithdraws         RampWithdraw[]        @relation("rampWithdraws")
  depositOrders         DepositOrder[]        @relation("depositOrders")
  oAuthConnections      OAuthConnection[]     @relation("oAuthConnections")
  // --------------- STATE --------------
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  mfa_enabled           Boolean?
  providerMetadata      Json?
  followerCount         Int?
  imageSrc              String? // Avatar URL
  country               String? // Player's country  eg. US, DE
  mintCredits           Int                   @default(3) // Mint for free!
  banned                Boolean               @default(false)
  blocked               Boolean? // Prevents others from interacting with this person
  refreshToken          String?
  accessToken           String?
  accessTokenExpiration DateTime?
  ramps                 Ramp[]
  oAuth                 OAuth[]
  clients               ClientsOnDevelopers[]
  promotions            PromotionsOnUsers[]
  betaAccess            Boolean               @default(false)
  TransferFrom          Transfer[]            @relation(name: "fromUser")
  TransferReceived      Transfer[]            @relation(name: "toUser")

  @@id([provider, id])
  @@unique([username, provider])
}

model Ramp {
  id                 String         @id @default(uuid())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User?          @relation(fields: [userId, userProvider], references: [id, provider])
  userProvider       ProviderType
  userId             String?
  type               RampType
  email              String?
  address            String?
  // Plaid
  accountId          String?
  accountNickname    String?
  mask               String?
  isoCurrencyCode    String?
  itemId             String? // Used to identify an Item in a webhook
  verificationStatus String? // Only used for Auth Item initiated through Automated or Manual micro-deposits
  // Coinbase
  // TODO: Replace with oAuthConnection
  accessToken        String?
  refreshToken       String?
  RampWithdraw       RampWithdraw[]
}

model DepositOrder {
  id           Int          @id @default(autoincrement())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  // --------------- LINKS --------------
  user         User         @relation("depositOrders", fields: [userId, userProvider], references: [id, provider])
  userProvider ProviderType
  userId       String
  // --------------- STATE --------------
  amount       Float?
  paymentType  RampType
  status       TxStatus     @default(UNSUBMITTED)
}

model MintPurchase {
  id                Int                      @id @default(autoincrement())
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  // --------------- LINKS --------------
  user              User                     @relation("mintPurchases", fields: [userId, userProvider], references: [id, provider])
  userProvider      ProviderType
  userId            String
  // --------------- STATE --------------
  gameId            String
  gameEndTime       String
  title             String // Treasure title
  // Order details
  paymentType       String                   @default("MINTCREDIT") // MINTCREDIT
  status            RampStatus               @default(PENDING)
  // Stripe
  orderStatus       MintPurchaseOrderStatus?
  // Blockchain
  staleTransactions Transaction[]            @relation("staleMintTransactions")
  transaction       Transaction?             @relation(fields: [transactionId], references: [id])
  transactionId     String?                  @unique
}

model OAuth {
  state         String        @id
  codeChallenge String
  codeVerifier  String
  createdAt     DateTime      @default(now())
  user          User?         @relation(fields: [userId, userProvider], references: [id, provider])
  userProvider  ProviderType?
  userId        String?
}

model ClientsOnDevelopers {
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId, userProvider], references: [id, provider], onDelete: Cascade)
  userProvider ProviderType
  userId       String
  oidc         Oidc              @relation(fields: [oidcId, oidcType], references: [id, type], onDelete: Cascade)
  oidcId       String
  oidcType     Int               @default(7)
  accessLevel  ClientAccessLevel

  @@id([userId, oidcId])
}

model Oidc {
  id         String    @default(cuid())
  type       Int
  grantId    String?
  userCode   String?
  uid        String?   @unique
  expiresAt  DateTime?
  payload    Json
  disabled   Boolean? // Allow developers to disable "delete" clients
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  developers ClientsOnDevelopers[]
  Transfer   Transfer[]

  @@id([id, type])
}

model OAuthConnection {
  id           String              @id @default(uuid())
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation("oAuthConnections", fields: [userId, userProvider], references: [id, provider])
  userProvider ProviderType
  userId       String
  type         OAuthConnectionType
  revoked      Boolean             @default(false)
  refreshToken String?
  accessToken  String
  expiration   DateTime?
}

model RampWithdraw {
  id            String       @id @default(uuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  status        RampStatus   @default(PENDING)
  toAddress     String
  amount        Int
  transaction   Transaction  @relation(fields: [transactionId], references: [id])
  transactionId String       @unique
  user          User?        @relation("rampWithdraws", fields: [userId, userProvider], references: [id, provider])
  userProvider  ProviderType
  userId        String?
  ramp          Ramp         @relation(fields: [rampId], references: [id])
  rampId        String
}

model Transaction {
  id                   String        @id
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  // --------------- STATE --------------
  status               TxStatus      @default(SUBMITTED)
  gasLimit             Int           @default(0)
  maxPriorityFeePerGas Int           @default(0)
  maxFeePerGas         Int           @default(0)
  rampWithdraw         RampWithdraw?
  mintPurchase         MintPurchase? @relation("staleMintTransactions", fields: [mintPurchaseId], references: [id])
  mintPurchaseId       Int?
  Transfer             Transfer[]
  MintPurchase         MintPurchase?
}

model Transfer {
  id               String       @id
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  transaction      Transaction  @relation(fields: [transactionId], references: [id])
  facilitator      Oidc         @relation(fields: [oidcId, oidcType], references: [id, type])
  oidcId           String
  oidcType         Int          @default(7)
  externalTransfer Boolean
  from             User         @relation("fromUser", fields: [fromUserId, fromUserProvider], references: [id, provider])
  fromUserProvider ProviderType
  to               User         @relation("toUser", fields: [toUserId, toUserProvider], references: [id, provider])
  toUserProvider   ProviderType
  collectionId     String
  transactionId    String
  fromUserId       String
  toUserId         String
}

model Promotion {
  id          Int                 @id @default(autoincrement())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  rewardType  PromotionRewardType @default(MINT_CREDIT)
  type        PromotionType
  mintCredits Int? // How many mint credits should be given
  enabled     Boolean             @default(false)
  users       PromotionsOnUsers[]
}

model PromotionsOnUsers {
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId, userProvider], references: [id, provider])
  userProvider ProviderType
  userId       String
  promotion    Promotion    @relation(fields: [promotionId], references: [id])
  promotionId  Int

  @@id([userId, promotionId])
}

enum ClientAccessLevel {
  OWNER // Can disable client
  EDITOR // Can update redirect urls
}

enum RampType {
  COINBASE
}

enum ProviderType {
  CHESS
  GOOGLE
  DISCORD
  TWITTER
  APPLE
  NATIVE // WebAuthn
  ETHEREUM // Metamask
  NODE_OIDC // Test provider
  TWITCH
  EPIC_GAMES
  REDDIT
  SPOTIFY
}

enum OAuthConnectionType {
  TWITCH
  COINBASE
  DISCORD
}

enum RampStatus {
  PENDING
  COMPLETE
  FAILED
}

enum TxStatus {
  UNSUBMITTED
  SUBMITTED
  COMPLETE
  FAILED
}

enum MintPurchaseOrderStatus {
  RESERVATION
  COMPLETE
}

enum PromotionRewardType {
  MINT_CREDIT
}

enum PromotionType {
  TWITCH_CONNECTION
}
