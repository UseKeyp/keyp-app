{
  "github": {
    "silent": true
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "has": [
        {
          "type": "host",
          "value": "api.usekeyp.com"
        }
      ],
      "destination": "/api/v1"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "oauth.usekeyp.com"
        }
      ],
      "destination": "/api/oauth"
    }
  ]
}
