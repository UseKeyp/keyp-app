{
  "name": "@usekeyp/common",
  "version": "1.2.8",
  "private": true,
  "description": "Common utility functions and constants used across web and api packages",
  "main": "dist/index.js",
  "module": "src/index.js",
  "scripts": {
    "build": "babel src -d dist",
    "build:watch": "nodemon --watch src --ext \"js,ts,tsx\" --ignore dist --exec \"yarn build\""
  },
  "devDependencies": {
    "@babel/cli": "^7.20.7",
    "@babel/core": "^7.20.12",
    "@babel/node": "^7.20.7",
    "@babel/preset-env": "^7.20.2",
    "nodemon": "^2.0.20"
  }
}
